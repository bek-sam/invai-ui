{
  "name": "@invai/ui",
  "version": "0.1.0",
  "description": "Shared React components (shadcn/ui), theme tokens and English/Spanish strings for invai-web and invai-floor",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/theme.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@invai/contracts": "link:../invai-contracts",
    "radix-ui": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "lucide-react": "^1.47.0",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.15",
    "cmdk": "^1.1.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.5.14",
    "vitest": "^5.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  }
}
